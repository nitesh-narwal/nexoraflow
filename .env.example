# Copy to .env to override. These are LOCAL DEVELOPMENT defaults, not secrets: change them for any shared environment.
POSTGRES_DB=nexoraflow
POSTGRES_USER=nexoraflow
POSTGRES_PASSWORD=nexoraflow_dev
NEXORA_DB_PORT=5432
NEXORA_PORT=8080
# dataset: SMALL (50 employees) | MEDIUM (400, default) | LARGE (2000)
NEXORA_SIZE=MEDIUM
NEXORA_SEED=20261022
NEXORA_ALLOW_RESET=true
# command for `docker compose --profile tools run --rm pipeline`
NEXORA_COMMAND=full-pipeline
